# Public URL the app is served from (used for OIDC redirects)
EXPLORER_PUBLIC_URL=https://files.example.com

EXPLORER_OIDC_ISSUER=https://id.example.com
EXPLORER_OIDC_CLIENT_ID=explorer
EXPLORER_OIDC_CLIENT_SECRET=change-me
# Alternative to EXPLORER_OIDC_CLIENT_SECRET: path to a file containing the secret
# EXPLORER_OIDC_CLIENT_SECRET_FILE=/run/secrets/explorer_oidc_client_secret

# Only if the provider's certificate is signed by a private CA: PEM file of CA certificates
# EXPLORER_OIDC_CA_FILE=/run/secrets/explorer_oidc_ca.pem

# Only members of this group may sign in
EXPLORER_ALLOWED_GROUP=explorer-users
EXPLORER_OIDC_GROUPS_CLAIM=groups

EXPLORER_SESSION_TTL=7d

# Network(s) of the reverse proxy, so sign-in limits apply per client (see docs/installation.md)
# EXPLORER_TRUSTED_PROXIES=172.18.0.0/16

EXPLORER_LOG=info
# pretty | json
EXPLORER_LOG_FORMAT=pretty
